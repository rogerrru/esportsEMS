# Copy this file to .env and fill in values before running locally.
# On Render, set these as Environment Variables in the dashboard.

# Port the server listens on (Render injects this automatically)
PORT=3000

# Comma-separated allowed origins for CORS.
# Example: https://your-username.github.io
# Leave as * during development to allow all origins.
ALLOWED_ORIGIN=*

# Riot Games Developer API key — get one at https://developer.riotgames.com
# Dev keys expire every 24 hours. For production, register a personal API key.
RIOT_API_KEY=
